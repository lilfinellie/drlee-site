---
import Base from '../layouts/Base.astro';
import DocPage from '../components/DocPage.astro';
import Faq from '../components/Faq.astro';
import { faqSchema, type QA } from '../data/faq';

const faqs: QA[] = [
  { q: '骨密度檢查怎麼做？會痛嗎？',
    a: '<p>不會痛。檢查時平躺在檢查台上，儀器從身體上方掃過腰椎與髖關節，大約 10–15 分鐘，不需要打針，輻射劑量非常低。檢查前一兩天避免服用鈣片，身上不要有金屬物品。</p>' },
  { q: '骨水泥和千斤頂差在哪裡？',
    a: '<p>兩者都是經由背部的小針孔處理骨鬆壓迫性骨折。骨水泥椎體成形術是直接把骨水泥注入塌陷的椎體，穩定骨折、減輕疼痛；千斤頂（椎體撐開成形術）是先放入可撐開的支架，把塌陷的椎體撐回較接近原本的高度，再灌入骨水泥固定。千斤頂需要自費，是否適合要看骨折的型態與時間，歡迎到門診討論。</p>' },
  { q: '打完骨水泥之後，還會再骨折嗎？',
    a: '<p>骨水泥處理的是已經骨折的那一節，但骨質疏鬆本身還在。發生過一次骨鬆骨折的人，之後再骨折的機會明顯升高，可能發生在其他節脊椎或髖部。所以術後一定要同時治療骨質疏鬆，並注意防跌。</p>' },
  { q: '我已經骨折了，還需要吃骨鬆藥嗎？',
    a: '<p>需要，而且更重要。骨折代表骨質已經相當脆弱，治療骨質疏鬆可以降低下一次骨折的風險。發生骨鬆骨折後，部分骨鬆藥物的健保給付條件也會放寬，門診會依你的骨密度與骨折狀況說明。</p>' },
  { q: '男性也會骨質疏鬆嗎？',
    a: '<p>會。男性骨質流失通常比女性晚，但 70 歲以上、長期使用類固醇、抽菸、飲酒過量或有慢性疾病的男性，同樣有骨鬆與骨折的風險，也建議接受骨密度檢查。</p>' },
];
const toc = [
  { id: 'what', label: '骨質疏鬆是什麼' },
  { id: 'signs', label: '容易被忽略的徵兆' },
  { id: 'dxa', label: '骨密度檢查' },
  { id: 'treat', label: '骨質疏鬆的治療' },
  { id: 'fracture', label: '壓迫性骨折怎麼處理' },
  { id: 'procedures', label: '骨水泥與千斤頂' },
  { id: 'faq', label: '常見問題' },
];
---
<Base
  title="骨質疏鬆與脊椎壓迫性骨折：骨密度檢查、骨水泥與千斤頂"
  description="輕微跌倒、咳嗽或彎腰就背痛，可能是骨質疏鬆造成的脊椎壓迫性骨折。奇美神經外科李瑤琳醫師說明骨密度檢查、骨鬆治療，以及骨水泥椎體成形術與千斤頂（椎體撐開成形術）的差別。"
  jsonld={[faqSchema(faqs)]}
>
  <DocPage
    eyebrow="Osteoporosis & compression fracture"
    title="骨質疏鬆｜骨密度檢查、壓迫性骨折、骨水泥與千斤頂"
    lede="骨質疏鬆本身不會痛，常常是骨折了才被發現。長輩彎腰提個東西、咳嗽一下或輕輕跌坐，就可能讓脊椎塌陷。及早檢查骨密度，是預防骨折最簡單的一步。"
    toc={toc}
    related={['/low-back-pain/', '/trauma/', '/faq/']}
  >
    <h2 id="what">骨質疏鬆是什麼</h2>
    <p>骨頭會不斷地新陳代謝。隨著年紀增長，骨質流失的速度大於生成，骨頭內部的結構變得稀疏、脆弱，就是骨質疏鬆。最容易發生骨折的位置是<strong>脊椎</strong>、<strong>髖部</strong>與<strong>手腕</strong>。</p>
    <p>以下族群風險較高：</p>
    <ul>
      <li>停經後女性、65 歲以上女性、70 歲以上男性</li>
      <li>長期使用類固醇</li>
      <li>體重過輕、抽菸、飲酒過量、缺乏運動</li>
      <li>家族中有人髖部骨折</li>
      <li>類風濕性關節炎、甲狀腺或副甲狀腺疾病、慢性腎病等</li>
      <li>曾經輕微碰撞就骨折</li>
    </ul>

    <h2 id="signs">容易被忽略的徵兆</h2>
    <ul>
      <li>身高變矮，比年輕時少了 3–4 公分以上</li>
      <li>駝背越來越明顯</li>
      <li>沒有明顯外傷，突然背痛，翻身、起床時特別痛</li>
      <li>輕微跌倒、搬東西、咳嗽或打噴嚏後背痛</li>
    </ul>
    <div class="callout warn"><p>背痛合併腳麻、腳無力或大小便異常，可能是骨折壓迫到神經，請盡快就醫。</p></div>

    <h2 id="dxa">骨密度檢查</h2>
    <p>診斷骨質疏鬆最標準的方式，是<strong>雙能量 X 光吸收儀（DXA）</strong>，測量腰椎與髖關節的骨密度。檢查不痛、不用打針，約 10–15 分鐘完成。</p>
    <div class="table-wrap">
      <table class="cmp">
        <thead><tr><th>T 值</th><th>判讀</th><th>建議</th></tr></thead>
        <tbody>
          <tr><td>−1.0 以上</td><td>正常</td><td>維持運動、鈣與維生素 D</td></tr>
          <tr><td>−1.0 到 −2.5</td><td>骨量減少（骨缺乏）</td><td>評估骨折風險，調整生活習慣，定期追蹤</td></tr>
          <tr><td>−2.5 以下</td><td>骨質疏鬆</td><td>建議開始骨鬆治療</td></tr>
        </tbody>
      </table>
    </div>
    <p>已經發生過脊椎或髖部的骨鬆骨折，即使 T 值沒有低於 −2.5，也視為骨質疏鬆，需要治療。健保給付骨密度檢查有一定條件，不符合時也可以自費檢查。</p>

    <h2 id="treat">骨質疏鬆的治療</h2>
    <h3>每個人都需要的基礎</h3>
    <ul>
      <li>足夠的鈣質與維生素 D，必要時補充</li>
      <li>負重與肌力運動，例如快走、深蹲、彈力帶訓練</li>
      <li>戒菸、避免過量飲酒</li>
      <li>居家防跌：照明充足、浴室止滑、移除地上雜物</li>
    </ul>
    <h3>藥物治療</h3>
    <p>藥物分成兩大類：<strong>抑制骨質流失</strong>（口服或注射，有每週、每月、每半年或每年一次等不同劑型），以及<strong>促進骨質生成</strong>（每天或每月注射，通常用在骨折風險很高的病人）。選擇會依骨密度、骨折狀況、腎功能與生活習慣決定。部分藥物的健保給付需要符合骨折與骨密度條件，門診會一併說明。</p>

    <h2 id="fracture">壓迫性骨折怎麼處理</h2>
    <p>骨鬆造成的脊椎壓迫性骨折，多數可以先保守治療：</p>
    <ul>
      <li>止痛藥物</li>
      <li>配戴背架，減少脊椎受力</li>
      <li>在疼痛可以忍受的範圍內儘早下床活動，避免長期臥床造成肌肉流失、肺炎或血栓</li>
      <li>同時開始治療骨質疏鬆</li>
    </ul>
    <p>如果經過數週保守治療仍然劇痛、無法下床，椎體持續塌陷，或影像顯示骨折癒合不良，就可以考慮微創的骨水泥或千斤頂手術。若骨折壓迫到神經或造成脊椎不穩定，則可能需要減壓與<a href="/low-back-pain/">螺釘固定手術</a>。</p>

    <h2 id="procedures">骨水泥與千斤頂</h2>
    <h3>骨水泥椎體成形術</h3>
    <p>在 X 光導引下，經由背部約 0.5 公分的小針孔，把醫療用骨水泥注入塌陷的椎體。骨水泥在幾分鐘內硬化，穩定骨折、減輕疼痛。多數病人術後當天或隔天就能下床，疼痛明顯改善。</p>
    <h3>千斤頂（椎體撐開成形術）</h3>
    <p>同樣經由小傷口，先在塌陷的椎體內放入可撐開的支架，像千斤頂一樣把椎體往上撐，盡量恢復原本的高度與角度，再灌入骨水泥固定。適合塌陷較明顯、骨折時間較短的病人，有機會改善駝背角度。千斤頂需要自費。</p>
    <div class="table-wrap">
      <table class="cmp">
        <thead><tr><th></th><th>骨水泥椎體成形術</th><th>千斤頂（椎體撐開成形術）</th></tr></thead>
        <tbody>
          <tr><td><strong>做法</strong></td><td>直接注入骨水泥</td><td>先撐開椎體，再注入骨水泥</td></tr>
          <tr><td><strong>恢復椎體高度</strong></td><td>有限</td><td>較有機會恢復</td></tr>
          <tr><td><strong>傷口</strong></td><td>針孔大小</td><td>小傷口</td></tr>
          <tr><td><strong>費用</strong></td><td>部分材料可能需自費</td><td>自費</td></tr>
          <tr><td><strong>適合</strong></td><td>疼痛為主、塌陷程度較輕</td><td>塌陷較明顯、骨折時間較短</td></tr>
        </tbody>
      </table>
    </div>
    <p>兩種手術都有骨水泥滲漏等風險，術前我會依你的影像說明適合哪一種、費用多少。無論選哪一種，<strong>術後都要持續治療骨質疏鬆</strong>，才能降低下一次骨折的機會。</p>

    <h2 id="faq">常見問題</h2>
    <Faq items={faqs} />
  </DocPage>
</Base>
