---
import Base from '../layouts/Base.astro';
import DocPage from '../components/DocPage.astro';
import Faq from '../components/Faq.astro';
import { faqSchema, type QA } from '../data/faq';

const faqs: QA[] = [
  { q: '手麻一定是頸椎的問題嗎？',
    a: '<p>不一定。手麻也常見於腕隧道症候群（正中神經在手腕被壓迫）、肘隧道症候群，或糖尿病等周邊神經病變。門診會依麻的位置、誘發姿勢與神經學檢查判斷，必要時安排神經傳導檢查來區分。</p>' },
  { q: '頸椎前位手術（ACDF）後，脖子還能轉動嗎？',
    a: '<p>可以。融合一到兩節頸椎，對日常的轉頭、點頭影響通常不大。融合節數越多，活動角度受影響的程度越明顯，術前我會依你的狀況說明。</p>' },
  { q: '從脖子前面開刀，會影響吞嚥或聲音嗎？',
    a: '<p>術後幾天到幾週內，常有喉嚨卡卡、吞嚥時異物感，大多會逐漸改善。聲音沙啞較少見，通常也是暫時的。</p>' },
  { q: '術後需要戴頸圈嗎？多久可以上班？',
    a: '<p>依手術方式與固定情況而定，有些病人不需要頸圈，有些需要配戴數週。文書工作者多數在數週內可以恢復上班，需要搬重物的工作則需要較長時間。實際時程我會在術後依恢復狀況建議。</p>' },
  { q: '我已經手麻很久了，開刀後會完全恢復嗎？',
    a: '<p>手術的主要目的是解除壓迫、避免神經繼續受損。症狀越早處理，恢復機會越好；壓迫時間很長或脊髓已有變化時，部分麻木或無力可能無法完全恢復。這也是脊髓病變不建議拖延的原因。</p>' },
];
const toc = [
  { id: 'anatomy', label: '頸椎與神經' },
  { id: 'symptoms', label: '兩種壓迫，兩種症狀' },
  { id: 'redflags', label: '不要拖的警訊' },
  { id: 'tests', label: '需要做哪些檢查' },
  { id: 'conservative', label: '不開刀的治療' },
  { id: 'surgery', label: '手術方式' },
  { id: 'recovery', label: '術後恢復' },
  { id: 'faq', label: '常見問題' },
];
---
<Base
  title="頸椎椎間盤突出與脊髓壓迫：手麻、脖子痛與頸椎手術"
  description="脖子痛、手麻、扣釦子變不靈活，可能是頸椎神經根或脊髓受壓。奇美神經外科李瑤琳醫師說明症狀差異、檢查、保守治療，以及前位頸椎椎間盤切除融合（ACDF）與後位減壓固定手術。"
  jsonld={[faqSchema(faqs)]}
>
  <DocPage
    eyebrow="Cervical spine"
    title="頸椎｜手麻、脖子痛與頸椎手術"
    lede="頸椎裡同時有脊髓和往手臂走的神經根。被壓到的是哪一個，決定了症狀的樣子，也決定了要不要開刀、要多快處理。"
    toc={toc}
    related={['/low-back-pain/', '/minimally-invasive/', '/faq/']}
  >
    <h2 id="anatomy">頸椎與神經</h2>
    <p>頸椎共有七節，中間的椎管保護著<strong>脊髓</strong>，每一節兩側再分出<strong>神經根</strong>，負責肩膀、手臂到手指的感覺與力氣。</p>
    <p>隨著年紀與姿勢習慣，椎間盤可能突出、骨刺增生、韌帶變厚或鈣化，讓神經的空間越來越窄。</p>

    <h2 id="symptoms">兩種壓迫，兩種症狀</h2>
    <div class="table-wrap">
      <table class="cmp">
        <thead><tr><th></th><th>神經根壓迫（神經根病變）</th><th>脊髓壓迫（脊髓病變）</th></tr></thead>
        <tbody>
          <tr><td><strong>典型感覺</strong></td><td>脖子痛，痠麻一路延伸到手臂、手指</td><td>雙手麻、笨拙，不一定會痛</td></tr>
          <tr><td><strong>常見描述</strong></td><td>抬頭、轉頭時更痛；單側為主</td><td>扣釦子、寫字、拿筷子變差；走路不穩、像踩在棉花上</td></tr>
          <tr><td><strong>自然病程</strong></td><td>不少人經保守治療可改善</td><td>多半緩慢惡化，較少自行恢復</td></tr>
          <tr><td><strong>處理原則</strong></td><td>先保守治療，無效或無力時考慮手術</td><td>確診後通常建議及早手術</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="redflags">不要拖的警訊</h2>
    <div class="callout warn">
      <p>出現以下情況，請盡快就醫評估：</p>
      <ul>
        <li>手部明顯無力、肌肉萎縮</li>
        <li>精細動作變差，例如扣釦子、寫字困難</li>
        <li>走路不穩、容易跌倒</li>
        <li>大小便控制出現變化</li>
        <li>跌倒或車禍後出現手腳麻木無力</li>
      </ul>
    </div>

    <h2 id="tests">需要做哪些檢查</h2>
    <ul>
      <li><strong>神經學檢查</strong>：門診評估力氣、感覺、反射與步態，是判斷壓迫位置的第一步。</li>
      <li><strong>頸椎 X 光</strong>：包括前彎後仰的動態攝影，評估排列與穩定度。</li>
      <li><strong>MRI</strong>：看椎間盤、神經根與脊髓受壓的程度，以及脊髓是否已有變化。</li>
      <li><strong>CT</strong>：評估骨刺與後縱韌帶鈣化，規劃螺釘位置。</li>
      <li><strong>神經傳導與肌電圖</strong>：區分頸椎問題與<a href="/minimally-invasive/#carpal">腕隧道症候群</a>等周邊神經壓迫，兩者也可能同時存在。</li>
    </ul>

    <h2 id="conservative">不開刀的治療</h2>
    <p>以神經根症狀為主、沒有明顯無力的病人，大多先從保守治療開始：</p>
    <ul>
      <li>止痛、消炎或神經痛藥物</li>
      <li>復健治療、頸部肌力訓練與姿勢調整</li>
      <li>短期使用頸圈減少刺激</li>
      <li>必要時轉介神經阻斷注射</li>
    </ul>
    <p>規則治療約六到十二週仍無改善、症狀反覆影響生活，或出現無力時，就會討論手術。脊髓病變的處理邏輯不同：已有症狀的脊髓壓迫，通常不建議長時間觀察。</p>

    <h2 id="surgery">手術方式</h2>
    <h3>前位頸椎椎間盤切除與融合（ACDF）</h3>
    <p>從脖子前方約 3–4 公分的橫向小切口進入，在食道、氣管與頸動脈之間的自然間隙往深處走，移除壓迫神經的椎間盤與骨刺，再放入椎間支架，讓上下兩節頸椎癒合在一起。傷口通常沿著頸部的皺褶，癒合後不明顯。</p>
    <h3>後位減壓與固定</h3>
    <p>從脖子後方進入，移除壓迫脊髓的椎板與增厚的韌帶（椎板切除），讓脊髓往後退開、恢復空間；若頸椎不穩定，再以螺釘與連桿固定。另一種方式是椎板成形術，把椎板像開門一樣撐開擴大椎管，保留較多活動度。</p>
    <h3>前位還是後位？</h3>
    <div class="table-wrap">
      <table class="cmp">
        <thead><tr><th>考量</th><th>傾向前位（ACDF）</th><th>傾向後位</th></tr></thead>
        <tbody>
          <tr><td>壓迫來源</td><td>椎間盤、骨刺從前方壓迫</td><td>韌帶增厚、多節段狹窄、後縱韌帶大範圍鈣化</td></tr>
          <tr><td>節段數</td><td>一到兩、三節</td><td>三節以上</td></tr>
          <tr><td>頸椎排列</td><td>前凸消失或後彎時較有利</td><td>需保有正常前凸</td></tr>
        </tbody>
      </table>
    </div>
    <p>實際選擇會綜合影像與你的症狀，有時也會合併前後位一起處理。<span class="tbd">如有人工椎間盤等其他術式，可在此補充</span></p>

    <h2 id="recovery">術後恢復</h2>
    <ul>
      <li><strong>ACDF</strong>：多數病人術後隔天可下床活動，住院約 <span class="tbd">待填</span> 天。前幾天到幾週可能有喉嚨痛、吞嚥異物感。</li>
      <li><strong>後位手術</strong>：傷口較大，脖子後方痠痛較明顯，住院時間通常稍長。</li>
      <li>依醫囑決定是否配戴頸圈與配戴時間。</li>
      <li>術後數週內避免提重物、長時間低頭；開車與回到工作的時間依恢復狀況建議。</li>
      <li>術後會以 X 光追蹤融合與螺釘位置。</li>
    </ul>

    <h2 id="faq">常見問題</h2>
    <Faq items={faqs} />
  </DocPage>
</Base>
