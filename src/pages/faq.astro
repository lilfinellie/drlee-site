---
import Base from '../layouts/Base.astro';
import DocPage from '../components/DocPage.astro';
import Faq from '../components/Faq.astro';
import { faqSchema, type QA } from '../data/faq';
import { SITE } from '../data/site';

const common: QA[] = [
  { id: 'incidentaloma', q: '健檢 MRI 說腦下垂體有個小東西，我需要開刀嗎？',
    a: `<p>大多數不需要。健檢意外發現的腦下垂體病灶很常見，絕大多數是良性的腺瘤或囊腫。要不要處理，主要看三件事：</p>
<ul><li><strong>大小</strong>：小於 1 公分稱為微腺瘤，大於 1 公分稱為巨腺瘤。</li>
<li><strong>荷爾蒙</strong>：抽血檢查是否有荷爾蒙分泌過多或不足。</li>
<li><strong>視力</strong>：腫瘤是否靠近或壓迫視神經；巨腺瘤需要做視野檢查。</li></ul>
<p>如果是小、沒有分泌荷爾蒙、也沒有壓迫視神經的病灶，通常只需要定期追蹤 MRI 與抽血，一開始約半年到一年追蹤一次，穩定的話可以拉長間隔。</p>
<p>需要考慮手術的情況包括：壓迫視神經造成視力或視野變差、追蹤期間持續長大、分泌過多荷爾蒙（泌乳激素瘤以外，泌乳激素瘤多數先吃藥），或發生腦下垂體中風。</p>
<p>門診時請帶 MRI 光碟與報告，我會和你一起看影像，說明它在哪裡、離視神經多近，以及建議的追蹤方式。詳見<a href="/pituitary/">腦下垂體</a>頁面。</p>` },
  { id: 'prolactin', q: '泌乳激素偏高，一定是腫瘤嗎？',
    a: `<p>不一定。泌乳激素升高的原因很多，腫瘤只是其中之一。常見原因包括：</p>
<ul><li><strong>懷孕與哺乳</strong>：生理性升高，一定要先排除。</li>
<li><strong>藥物</strong>：部分精神科用藥、止吐藥、胃腸蠕動藥與某些降血壓藥，都可能讓泌乳激素上升。</li>
<li><strong>甲狀腺功能低下</strong>、<strong>腎功能不佳</strong>。</li>
<li><strong>抽血時的壓力或剛運動完</strong>：輕微升高時，建議休息後重抽一次。</li>
<li><strong>巨泌乳激素</strong>：檢驗數字偏高，但生物活性低，不一定造成症狀。</li>
<li><strong>腦下垂體腫瘤</strong>：包括會分泌泌乳激素的泌乳激素瘤，以及壓迫到腦下垂體柄、讓泌乳激素輕度上升的其他腫瘤。</li></ul>
<p>評估時會先確認用藥、懷孕與甲狀腺功能，必要時重複抽血，持續偏高再安排腦下垂體 MRI。即使是泌乳激素瘤，多數也可以先用口服藥物治療，不一定需要開刀。</p>` },
  { id: 'nose-smell', q: '經鼻內視鏡手術後，鼻子會變形嗎？嗅覺會不見嗎？',
    a: `<p><strong>鼻子外觀不會改變。</strong>手術完全從鼻孔內進行，臉上與鼻子外面都沒有傷口。</p>
<p>術後常見、通常會逐漸改善的情況：</p>
<ul><li>鼻塞、鼻涕帶血絲、鼻腔結痂，大約持續數週</li>
<li>需要規律用生理食鹽水沖洗鼻腔，並回診清理</li>
<li>術後數週內避免用力擤鼻涕、憋氣用力或提重物，打噴嚏時張開嘴巴</li></ul>
<p><strong>嗅覺</strong>：術後初期因黏膜腫脹，嗅覺可能暫時變差，多數病人會隨著鼻腔癒合逐漸恢復。腫瘤較大、需要較大範圍顱底重建時，影響嗅覺的機會較高，這部分我會在術前依你的腫瘤個別說明。</p>
<p>如果術後鼻子持續流出像清水一樣的液體，特別是低頭時變多，可能是腦脊髓液鼻漏，請盡快回診或就醫。</p>` },
];
const booking: QA[] = [
  { q: '李醫師的門診時間是什麼時候？',
    a: `<p>${SITE.clinicText}，地點在${SITE.hospital.name}${SITE.hospital.dept}。週三夜診只有單數週開診，出發前建議到掛號系統確認。</p>` },
  { q: '怎麼掛號？',
    a: `<p>可以透過<a href="${SITE.hospital.bookingUrl}" target="_blank" rel="noopener">奇美醫院網路掛號</a>，選擇永康院區、神經外科、李瑤琳醫師；也可以使用醫院電話語音掛號或現場掛號。</p>` },
  { q: '需要轉診單嗎？',
    a: '<p>不需要轉診單也可以看診，但持有其他醫療院所的轉診單，可以減少部分負擔。若已在其他醫院做過檢查，建議一併申請病歷摘要與影像光碟。</p>' },
];
const visit: QA[] = [
  { q: '第一次看診要帶什麼？',
    a: '<p>健保卡、目前用藥清單，以及已經做過的 MRI 或 CT 影像光碟與報告、抽血報告。腦下垂體病人若有視野檢查結果也請帶來。可以參考<a href="/#prep">首頁的看診準備清單</a>。</p>' },
  { q: '我在別家醫院已經被建議開刀，可以來聽第二意見嗎？',
    a: '<p>可以，也很歡迎。請帶齊影像光碟與報告，我會根據你的影像與症狀說明我的看法，以及開刀與不開刀的選項。</p>' },
  { q: '我住在外縣市，可以先寄影像給你看嗎？',
    a: '<p>基於醫療法規與病人安全，診斷與治療建議需要在門診當面評估。建議直接掛號，並把影像光碟帶到門診。</p>' },
  { q: '家人可以陪同看診嗎？',
    a: '<p>可以。討論檢查結果或手術計畫時，很鼓勵家人一起來，一起聽、一起問。</p>' },
];
const surgery: QA[] = [
  { q: '手術需要等多久？',
    a: '<p>依病情的急迫性安排。視力快速惡化、神經無力加重等情況會優先處理；一般排程手術會在門診討論後，依床位與手術室時程安排。</p>' },
  { q: '手術費用健保有給付嗎？有哪些自費項目？',
    a: '<p>大部分手術本身有健保給付。部分特殊耗材，例如某些脊椎植入物、止血材料或人工硬腦膜，可能需要自費或差額負擔。術前門診會說明所有自費項目與費用，由你決定是否使用。</p>' },
  { q: '手術前要停哪些藥？',
    a: '<p>抗凝血劑、抗血小板藥物，以及部分保健食品（如魚油、銀杏）可能增加出血風險。請不要自行停藥，門診時把完整用藥清單帶來，我們會和你的開藥醫師一起安排停藥時間。</p>' },
];
const all = [...common, ...booking, ...visit, ...surgery];
const toc = [
  { id: 'common', label: '門診最常被問的問題' },
  { id: 'booking', label: '掛號與門診' },
  { id: 'visit', label: '看診' },
  { id: 'surgery', label: '手術前' },
];
---
<Base
  title="門診常見問題：掛號、第二意見、外地病人與手術費用"
  description="李瑤琳醫師門診常見問題：腦下垂體偶發瘤要不要開刀、泌乳激素偏高的原因、經鼻內視鏡術後鼻子與嗅覺，門診時間與網路掛號方式、第一次看診要帶什麼、第二意見、外縣市病人、手術等待時間與自費項目說明。"
  jsonld={[faqSchema(all)]}
>
  <DocPage
    eyebrow="Clinic FAQ"
    title="門診常見問題"
    lede="門診最常被問的問題，以及掛號、看診與手術前準備的說明，都整理在這裡。各疾病更多的問題，請見各主題頁面底部。"
    toc={toc}
    related={['/pituitary/', '/cervical-spine/', '/low-back-pain/']}
  >
    <h2 id="common">門診最常被問的問題</h2>
    <Faq items={common} />
    <h2 id="booking">掛號與門診</h2>
    <Faq items={booking} />
    <h2 id="visit">看診</h2>
    <Faq items={visit} />
    <h2 id="surgery">手術前</h2>
    <Faq items={surgery} />
  </DocPage>
</Base>
