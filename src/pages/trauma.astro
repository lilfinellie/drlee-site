---
import Base from '../layouts/Base.astro';
import DocPage from '../components/DocPage.astro';
import Faq from '../components/Faq.astro';
import { faqSchema, type QA } from '../data/faq';

const faqs: QA[] = [
  { q: '長輩跌倒撞到頭，當下沒事，需要注意什麼？',
    a: '<p>長者、或有服用抗凝血劑與抗血小板藥物的人，跌倒後可能在數週到數月內慢慢出血，形成慢性硬腦膜下血腫。若出現頭痛加劇、走路不穩、單側無力、反應變慢或變得糊塗，請盡快就醫。</p>' },
  { q: '慢性硬腦膜下血腫開刀後會復發嗎？',
    a: '<p>有一定的復發機會，特別是長者或需要持續服用抗凝血藥物的病人。因此術後需要回診追蹤，若症狀再出現應盡快就醫。</p>' },
  { q: '家人腦出血開完刀，多久會醒？',
    a: '<p>取決於出血的位置、大小、腦部受傷程度與年紀，每個人差異很大。醫療團隊會依病人的意識變化與影像，持續和家屬說明病情。</p>' },
];
const toc = [
  { id: 'head', label: '頭部外傷' },
  { id: 'csdh', label: '慢性硬腦膜下血腫' },
  { id: 'ich', label: '自發性腦出血' },
  { id: 'spine', label: '脊椎外傷' },
  { id: 'family', label: '給家屬的話' },
  { id: 'faq', label: '常見問題' },
];
---
<Base
  title="腦出血與神經外傷：頭部外傷、慢性硬腦膜下血腫與脊椎骨折"
  description="奇美神經外科李瑤琳醫師說明頭部外傷、長者跌倒後的慢性硬腦膜下血腫、自發性腦出血的立體定位血塊抽吸，以及脊椎外傷的減壓與固定手術，並提供家屬照護須知。"
  jsonld={[faqSchema(faqs)]}
>
  <DocPage
    eyebrow="Neurotrauma"
    title="腦出血與外傷｜頭部、脊椎外傷與血塊處理"
    lede="外傷和腦出血常常是突然發生的，病人多半從急診進來，最焦慮的往往是家屬。這一頁整理常見的狀況與處理方式，幫助你理解醫療團隊正在做什麼。"
    toc={toc}
    related={['/minimally-invasive/', '/cervical-spine/', '/low-back-pain/']}
  >
    <div class="callout warn"><p>頭部或脊椎受傷後，若出現意識改變、劇烈頭痛、反覆嘔吐、手腳無力或麻木，請立即撥打 119 或前往急診。</p></div>

    <h2 id="head">頭部外傷</h2>
    <p>頭部外傷可能造成顱骨骨折、硬腦膜外出血、急性硬腦膜下出血或腦挫傷。處理方式依出血量、位置與意識狀態決定：</p>
    <ul>
      <li><strong>觀察與藥物</strong>：出血量小、意識清楚，住院密切觀察並追蹤電腦斷層。</li>
      <li><strong>開顱手術</strong>：出血量大或壓迫腦部時，緊急移除血塊、止血。</li>
      <li><strong>顱骨切除減壓</strong>：腦部嚴重腫脹時，暫時移除部分頭骨讓腦部有空間，日後再做顱骨修補。</li>
    </ul>

    <h2 id="csdh">慢性硬腦膜下血腫</h2>
    <p>常見於長者、飲酒者，或服用抗凝血劑與抗血小板藥物的人。輕微撞擊後，血液在數週到數月間慢慢累積，症狀可能被誤以為是老化或中風：頭痛、走路不穩、單側無力、反應變慢、記憶變差。</p>
    <p>有症狀或血腫較大時，多以<strong>頭骨鑽孔引流手術</strong>處理，傷口小、手術時間短，多數病人術後症狀明顯改善。<span class="tbd">可補充奇美是否提供中腦膜動脈栓塞等選項</span></p>

    <h2 id="ich">自發性腦出血</h2>
    <p>多與高血壓、血管病變有關。依出血位置與大小，可選擇藥物治療、開顱移除血塊，或以<a href="/minimally-invasive/#ich">立體定位血塊抽吸</a>經小骨孔引流深部血塊，減少對正常腦組織的破壞。</p>

    <h2 id="spine">脊椎外傷</h2>
    <p>車禍、高處跌落或長者骨質疏鬆跌倒，都可能造成脊椎骨折或脊髓損傷。</p>
    <ul>
      <li><strong>穩定性骨折</strong>：背架固定、止痛與復健。</li>
      <li><strong>不穩定骨折或神經壓迫</strong>：以減壓手術搭配椎弓根螺釘固定，適合時可經皮微創置入，並以導航輔助。</li>
      <li><strong>頸椎外傷</strong>：依損傷型態選擇前位或後位固定。</li>
    </ul>
    <p><span class="tbd">如有執行骨水泥椎體成形術，可在此補充</span></p>

    <h2 id="family">給家屬的話</h2>
    <ul>
      <li>把病人平常吃的藥（特別是抗凝血劑、抗血小板藥物）帶來或拍照給醫療團隊。</li>
      <li>記下受傷時間與經過，以及之後症狀的變化。</li>
      <li>神經外傷的恢復常以週、月計算，請和團隊保持溝通，也照顧好自己。</li>
    </ul>

    <h2 id="faq">常見問題</h2>
    <Faq items={faqs} />
  </DocPage>
</Base>
