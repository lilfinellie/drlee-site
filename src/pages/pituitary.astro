---
import Base from '../layouts/Base.astro';
import DocPage from '../components/DocPage.astro';
import Faq from '../components/Faq.astro';
import { faqSchema, type QA } from '../data/faq';

const faqs: QA[] = [
  { q: '健檢 MRI 發現腦下垂體有一顆小腫瘤，一定要開刀嗎？',
    a: '<p>不一定。小於 1 公分、沒有分泌異常荷爾蒙、也沒有壓迫視神經的腫瘤，大多只需要定期追蹤 MRI 與抽血。需要開刀的情況，主要是腫瘤壓迫視力、持續長大，或分泌過多荷爾蒙且藥物無法控制。</p>' },
  { q: '經鼻內視鏡手術後，鼻子外觀會改變嗎？',
    a: '<p>不會。手術完全從鼻孔內進行，臉上沒有傷口，鼻子外型不會改變。術後幾週內常見鼻塞、鼻涕帶血絲或結痂，需要規律做鼻腔沖洗。</p>' },
  { q: '手術後嗅覺會不見嗎？',
    a: '<p>多數病人術後嗅覺可以恢復。術後初期因鼻腔腫脹，嗅覺可能暫時變差，通常隨黏膜癒合逐漸改善。少數需要較大範圍顱底重建的手術，影響嗅覺的機會較高，我會在術前說明。</p>' },
  { q: '泌乳激素瘤需要開刀嗎？',
    a: '<p>大多數泌乳激素瘤先用口服藥物治療，腫瘤常會縮小、泌乳激素也會下降。藥物效果不好、無法耐受副作用，或病人有其他考量時，才會討論手術。</p>' },
  { q: '開完刀之後，還需要一輩子吃荷爾蒙嗎？',
    a: '<p>要看術前與術後腦下垂體的功能。有些病人術後功能完整，不需要補充；有些病人原本就有功能低下，或術後部分荷爾蒙不足，就需要長期補充，例如甲狀腺素或類固醇。這部分會和內分泌科一起追蹤調整。</p>' },
  { q: '腫瘤拿掉之後會復發嗎？',
    a: '<p>復發機率和腫瘤種類、大小，以及是否侵犯海綿竇等周邊構造有關。因此術後需要定期 MRI 追蹤，若有殘留或復發，還有再次手術、藥物或放射治療等選擇。</p>' },
];
const toc = [
  { id: 'what', label: '腦下垂體是什麼' },
  { id: 'types', label: '常見的腦下垂體疾病' },
  { id: 'symptoms', label: '哪些症狀要注意' },
  { id: 'tests', label: '需要做哪些檢查' },
  { id: 'treatment', label: '治療選擇' },
  { id: 'surgery', label: '經鼻內視鏡手術' },
  { id: 'recovery', label: '術後恢復與追蹤' },
  { id: 'faq', label: '常見問題' },
];
---
<Base
  title="腦下垂體腫瘤：症狀、檢查與經鼻內視鏡手術"
  description="腦下垂體腫瘤會造成視野變窄、月經異常、泌乳、肢端肥大或庫欣氏症。奇美神經外科李瑤琳醫師說明需要做哪些檢查、哪些可以吃藥或追蹤，以及經鼻內視鏡手術與術後恢復。"
  jsonld={[faqSchema(faqs)]}
>
  <DocPage
    eyebrow="Pituitary"
    title="腦下垂體腫瘤｜症狀、檢查與經鼻內視鏡手術"
    lede="腦下垂體只有豌豆大，卻負責調控全身多種荷爾蒙。它出問題時，症狀常常出現在眼睛、月經、體型或血壓血糖，而不是頭痛。這一頁整理了從發現、檢查到治療的完整過程。"
    toc={toc}
    related={['/minimally-invasive/', '/faq/']}
  >
    <h2 id="what">腦下垂體是什麼</h2>
    <p>腦下垂體位在頭顱正中央、鼻腔後上方一個叫「蝶鞍」的骨頭凹槽裡。它的正上方是<strong>視神經交叉</strong>，兩側是包覆頸動脈與眼球動作神經的<strong>海綿竇</strong>。</p>
    <p>它分泌的荷爾蒙，控制甲狀腺、腎上腺、生殖腺、生長，以及身體的水分平衡。因為位置特殊，腫瘤長大時常先壓到視神經；因為功能特殊，腫瘤即使很小，也可能因為分泌過多荷爾蒙而造成全身症狀。</p>

    <h2 id="types">常見的腦下垂體疾病</h2>
    <p>腦下垂體腫瘤絕大多數是<strong>良性</strong>的腺瘤。依照是否分泌荷爾蒙，處理方式差異很大。</p>
    <div class="grid2">
      <div class="mini"><span class="tag">Non-functioning adenoma</span><h3>無功能性腺瘤</h3><p>不分泌荷爾蒙，常長到夠大、壓迫視神經才被發現。</p></div>
      <div class="mini"><span class="tag">Prolactinoma</span><h3>泌乳激素瘤</h3><p>月經不規則、泌乳、不孕或性慾下降。多數以藥物治療。</p></div>
      <div class="mini"><span class="tag">Acromegaly</span><h3>生長激素腺瘤</h3><p>手腳、臉型慢慢變大，合併高血壓、糖尿病、打鼾。</p></div>
      <div class="mini"><span class="tag">Cushing's disease</span><h3>庫欣氏病</h3><p>腎上腺皮質促素過多，月亮臉、水牛肩、紫紋、血糖血壓失控。</p></div>
      <div class="mini"><span class="tag">Rathke's cleft cyst</span><h3>拉克氏囊腫</h3><p>先天性囊腫，多數不需處理，變大或有症狀時才考慮手術。</p></div>
      <div class="mini"><span class="tag">Craniopharyngioma</span><h3>顱咽管瘤</h3><p>位置更靠近下視丘，治療較複雜，常需擴大經鼻內視鏡手術。</p></div>
    </div>
    <div class="callout warn"><p><strong>腦下垂體中風</strong>：腫瘤突然出血或梗塞，會出現劇烈頭痛、視力急速下降、眼皮下垂或意識改變。這是急症，請立即就醫，不要等門診。</p></div>

    <h2 id="symptoms">哪些症狀要注意</h2>
    <h3>腫瘤壓迫造成的症狀</h3>
    <ul>
      <li>兩側視野變窄，常撞到門框、開車看不到旁邊來車</li>
      <li>視力模糊、看東西有缺角</li>
      <li>持續性頭痛（較不具特異性）</li>
    </ul>
    <h3>荷爾蒙過多或不足造成的症狀</h3>
    <ul>
      <li>月經不規則、沒有懷孕卻泌乳、不孕</li>
      <li>男性性慾下降、勃起功能障礙</li>
      <li>戒指戴不下、鞋子越買越大、臉型改變</li>
      <li>血壓、血糖難以控制，臉變圓，皮膚易瘀青</li>
      <li>容易疲倦、怕冷、食慾差、低血壓</li>
      <li>大量口渴、頻尿（尿崩症，較常見於術後或其他鞍區病灶）</li>
    </ul>

    <h2 id="tests">需要做哪些檢查</h2>
    <p>評估腦下垂體，靠的是三個面向，缺一不可：</p>
    <ol>
      <li><strong>腦下垂體 MRI</strong>：需要專門的薄切與顯影劑掃描，一般腦部 MRI 可能看不清楚小腫瘤。</li>
      <li><strong>荷爾蒙抽血</strong>：包括泌乳激素、生長激素與 IGF-1、皮質醇與 ACTH、甲狀腺功能、性荷爾蒙等。部分需要在早上抽，或做刺激、抑制試驗。</li>
      <li><strong>視野檢查</strong>：由眼科執行，可以客觀記錄視神經受壓的程度，也是術後追蹤的基準。</li>
    </ol>
    <p>這三項結果放在一起，才能判斷腫瘤的類型、要不要處理，以及處理的急迫性。</p>

    <h2 id="treatment">治療選擇</h2>
    <p>不是每一顆腦下垂體腫瘤都需要開刀。我會先說明不開刀的選項，再一起決定。</p>
    <div class="table-wrap">
      <table class="cmp">
        <thead><tr><th>方式</th><th>適合的情況</th><th>說明</th></tr></thead>
        <tbody>
          <tr><td><strong>定期追蹤</strong></td><td>小腫瘤、無荷爾蒙異常、未壓迫視神經</td><td>依大小每 6–12 個月追蹤 MRI 與抽血</td></tr>
          <tr><td><strong>藥物治療</strong></td><td>泌乳激素瘤為首選；部分生長激素或庫欣氏病的輔助治療</td><td>需長期規律服藥與追蹤</td></tr>
          <tr><td><strong>經鼻內視鏡手術</strong></td><td>壓迫視神經、持續長大、功能性腫瘤（泌乳激素瘤以外）</td><td>多數腦下垂體腫瘤的主要治療方式</td></tr>
          <tr><td><strong>放射治療</strong></td><td>術後殘留、復發，或不適合手術</td><td>如加馬刀、電腦刀，效果需較長時間呈現</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="surgery">經鼻內視鏡手術</h2>
    <p>腦下垂體位在頭的正中央，從鼻腔進去反而是最短、最直接的路徑。手術時，我透過鼻孔放入內視鏡，打開蝶竇與蝶鞍底部的薄骨，在高解析度的放大影像下切除腫瘤，同時保護正常的腦下垂體、視神經與頸動脈。</p>
    <ul>
      <li>臉上、頭皮都沒有傷口</li>
      <li>內視鏡提供廣角視野，可以看到顯微鏡看不到的角落</li>
      <li>奇美備有 2D 與 3D 內視鏡及手術導航系統，可依腫瘤位置選用（見<a href="/minimally-invasive/">微創手術與設備</a>）</li>
      <li>與耳鼻喉科合作處理鼻腔通道與重建</li>
    </ul>
    <h3>手術風險</h3>
    <p>每一種手術都有風險，術前我會依你的腫瘤個別說明。常見需要注意的包括：</p>
    <ul>
      <li><strong>腦脊髓液鼻漏</strong>：鼻子流出清水樣液體，必要時需再次修補</li>
      <li><strong>尿崩症或低血鈉</strong>：術後水分調節暫時失衡，多數為短期</li>
      <li><strong>荷爾蒙功能不足</strong>：部分病人需要補充荷爾蒙</li>
      <li><strong>鼻腔問題</strong>：鼻塞、結痂、流鼻血，通常數週內改善</li>
      <li>少見但嚴重的併發症，如血管損傷、視力惡化或感染</li>
    </ul>

    <h2 id="recovery">術後恢復與追蹤</h2>
    <ol>
      <li><strong>住院期間</strong>：密切監測尿量、血鈉與荷爾蒙。住院天數約 <span class="tbd">待填</span> 天。</li>
      <li><strong>出院後第一至二週</strong>：留意是否有噁心、頭痛、疲倦加重，這可能是延遲性低血鈉的表現，請盡快回診或就醫。</li>
      <li><strong>術後數週內</strong>：避免用力擤鼻涕、搬重物、憋氣用力，打噴嚏時張開嘴巴。依指示做鼻腔沖洗。</li>
      <li><strong>術後約三個月</strong>：追蹤 MRI 與完整荷爾蒙檢查，之後依結果安排長期追蹤。</li>
    </ol>
    <div class="callout"><p>腦下垂體的照顧是一段長期的合作。手術只是其中一步，之後的荷爾蒙與影像追蹤同樣重要。</p></div>

    <h2 id="faq">常見問題</h2>
    <Faq items={faqs} />
  </DocPage>
</Base>
